<% layout("/layouts/boilerplate") %>

<div class="container py-5">
  <h3 class="text-danger fw-bold mb-4">⚠️ Confirm Delete Donor</h3>

  <p>Are you sure you want to delete the following donor? This action <strong>cannot be undone</strong>.</p>

  <ul>
    <li><strong>Name:</strong> <%= donor.name %></li>
    <li><strong>Email:</strong> <%= donor.email %></li>
    <li><strong>Phone:</strong> <%= donor.phone %></li>
    <li><strong>City:</strong> <%= donor.city %></li>
  </ul>

  <form action="/admin/donor/<%= donor._id %>/delete" method="POST" class="d-inline">
    <button class="btn btn-danger">Yes, Delete Donor</button>
  </form>
  <a href="/admin/donors" class="btn btn-secondary">Cancel</a>
</div>
