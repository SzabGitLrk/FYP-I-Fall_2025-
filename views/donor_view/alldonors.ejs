<% layout("/layouts/boilerplate") %>

<div class="container py-5">
  <h3 class="text-success fw-bold mb-4">👤 All Donors</h3>

  <table class="table table-bordered table-hover shadow-sm">
    <thead class="table-success">
      <tr>
        <th>Name</th>
        <th>Email</th>
        <th>Phone</th>
        <th>City</th>
        <th>Status</th> <!-- Active/Suspended -->
        <th>Actions</th>
      </tr>
    </thead>

    <tbody>
      <% donor.forEach(d => { %>
        <tr>
          <td><%= d.name %></td>
          <td><%= d.email %></td>
          <td><%= d.phone %></td>
          <td><%= d.city %></td>
          <td><%= d.status || "Active" %></td>

          <td>
            <!-- View Donation History -->
            <a href="/admin/donor/<%= d._id %>/donations"
               class="btn btn-sm btn-outline-primary mb-1">
              History
            </a>

            <!-- Suspend / Reactivate -->
            <form action="/admin/donor/<%= d._id %>/status?_method=PATCH"
                  method="POST" style="display:inline-block;">
              <button class="btn btn-sm btn-warning mb-1">
                <%= d.status === "Suspended" ? "Activate" : "Suspend" %>
              </button>
            </form>

            <!-- Remove Donor: Redirect to confirmation page -->
            <a href="/admin/donor/<%= d._id %>/delete" 
               class="btn btn-sm btn-outline-danger mb-1">
              Remove
            </a>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <div class="mt-4">
    <a href="/admin/dashboard" class="btn btn-outline-success">
      ⬅ Back to Dashboard
    </a>
  </div>
</div>
