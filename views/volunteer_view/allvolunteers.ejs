<% layout("/layouts/boilerplate") %>

<div class="container py-5">
  <h3 class="text-success fw-bold mb-4">🤝 All Volunteers</h3>
  <table class="table table-bordered table-hover shadow-sm">
    <thead class="table-success">
      <tr>
        <th>Name</th>
        <th>Email</th>
        <th>Phone</th>
        <th>City</th>
        <th>NGO</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>

    <tbody>
      <% volunteer.forEach(v => { %>
        <tr>
          <td><%= v.name %></td>
          <td><%= v.email %></td>
          <td><%= v.phone %></td>
          <td><%= v.city %></td>
          <td><%= v.ngo_id?.ngo_name || "N/A" %></td>
          <td><%= v.status %></td>
          <td>
            <!-- Suspend / Reactivate -->
            <form action="/admin/volunteer/<%= v._id %>/status?_method=PATCH"
                  method="POST" style="display:inline-block;">
              <button class="btn btn-sm btn-warning mb-1">
                <%= v.status === "Suspended" ? "Activate" : "Suspend" %>
              </button>
            </form>

            <!-- View Activity -->
            <a href="/admin/volunteer/<%= v._id %>/activity"
               class="btn btn-sm btn-outline-primary mb-1">
              Activity
            </a>

            <!-- Remove Volunteer -->
            <a href="/admin/volunteer/<%= v._id %>/delete"
               class="btn btn-sm btn-outline-danger mb-1">
              Remove
            </a>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <div class="mt-4">
    <a href="/admin/dashboard" class="btn btn-outline-success">
      ⬅ Back to Dashboard
    </a>
  </div>
</div>
