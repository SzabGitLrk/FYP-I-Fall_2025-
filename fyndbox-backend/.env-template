# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_database_password
DB_NAME=fyndbox

# Application
NODE_ENV=development
PORT=3002

# JWT
JWT_SECRET=your-secret-key

# AWS Image Storage
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=your_aws_region
AWS_S3_BUCKET_NAME=your_bucket_name

# Gmail SMTP Email Service (using Nodemailer)
# Note: MAIL_PASSWORD must be a Gmail App Password (NOT your regular Gmail password)
# Generate one at: Google Account → Security → 2-Step Verification → App Passwords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password_here
MAIL_FROM=YourAppName <your_email@gmail.com>

# Frontend
FRONTEND_URL=http://localhost:5173
PRODUCT_NAME=FyndBox

# Gemini API
GEMINI_PROVIDER=google
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_THINKING_BUDGET=0
AI_TEXT_RATE_LIMIT_WINDOW_MS=60000
AI_TEXT_RATE_LIMIT_MAX_REQUESTS=20
AI_LLM_RATE_LIMIT_WINDOW_MS=60000
AI_LLM_RATE_LIMIT_MAX_REQUESTS=10
AI_LLM_MAX_TOKENS_PER_REQUEST=500
AI_LLM_MAX_TOKENS_PER_MINUTE=5000

# Voice Transcription

WHISPER_CHUNK_DURATION_SECONDS=4
