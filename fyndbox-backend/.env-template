# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_database_password
DB_NAME=fyndbox

# Application
NODE_ENV=development
PORT=3002

# JWT
JWT_SECRET=your-secret-key

# AWS Image Storage
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=your_aws_region
AWS_S3_BUCKET_NAME=your_bucket_name

# Postmark Email Service
POSTMARK_API_KEY=your_postmark_api_key_here
POSTMARK_FROM_EMAIL=noreply@your-domain.com
POSTMARK_WELCOME_TEMPLATE_ID=your_welcome_template_id
POSTMARK_FORGOT_PASSWORD_TEMPLATE_ID=your_forgot_password_template_id

# Frontend
FRONTEND_URL=http://localhost:5173
PRODUCT_NAME=FyndBox

# Gemini API
GEMINI_PROVIDER=google
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_THINKING_BUDGET=0
AI_TEXT_RATE_LIMIT_WINDOW_MS=60000
AI_TEXT_RATE_LIMIT_MAX_REQUESTS=20
AI_LLM_RATE_LIMIT_WINDOW_MS=60000
AI_LLM_RATE_LIMIT_MAX_REQUESTS=10
AI_LLM_MAX_TOKENS_PER_REQUEST=500
AI_LLM_MAX_TOKENS_PER_MINUTE=5000

# Voice Transcription

WHISPER_CHUNK_DURATION_SECONDS=4
